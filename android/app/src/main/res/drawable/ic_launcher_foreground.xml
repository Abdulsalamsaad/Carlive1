<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — "C" arc in gold (#E8A33D) on transparent background.
  Safe zone: 66dp × 66dp centred in 108dp × 108dp canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer gold ring (the "C" arc: 270° sweep, opening at right) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#E8A33D"
        android:strokeWidth="9"
        android:pathData="M 72,54
                          A 18,18 0 1 1 71.9999,54.001"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

    <!-- Simpler solid "C" shape using arcs -->
    <path
        android:fillColor="#E8A33D"
        android:pathData="
          M 68,38
          A 21,21 0 0 0 40,54
          A 21,21 0 0 0 68,70
          L 68,62
          A 13,13 0 0 1 48,54
          A 13,13 0 0 1 68,46
          Z"/>

    <!-- Small gold dot bottom-right for brand mark -->
    <circle
        android:fillColor="#E8A33D"
        android:cx="68"
        android:cy="68"
        android:r="3.5"/>
</vector>
